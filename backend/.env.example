# Server & Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata

# MySQL Database (Hostinger VPS)
DATABASE_URL="mysql://lms_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:3306/argon_lms_db"

# JWT & Session Security (Must be 32+ chars in production)
JWT_ACCESS_SECRET="CHANGE_ME_32_CHAR_MIN_ACCESS_SECRET_KEY_ARGON"
JWT_REFRESH_SECRET="CHANGE_ME_32_CHAR_MIN_REFRESH_SECRET_KEY_ARGON"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SECURE=false

# Field-Level Encryption Key for UPI IDs (32-byte hex)
UPI_ENCRYPTION_KEY_HEX="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"

# Provider Adapters (Placeholders - configure on Hostinger VPS)
RAZORPAY_KEY_ID="rzp_test_PLACEHOLDER"
RAZORPAY_KEY_SECRET="RAZORPAY_SECRET_PLACEHOLDER"
RAZORPAY_WEBHOOK_SECRET="RAZORPAY_WEBHOOK_SECRET_PLACEHOLDER"

HMS_100MS_ACCESS_KEY="HMS_ACCESS_KEY_PLACEHOLDER"
HMS_100MS_APP_SECRET="HMS_APP_SECRET_PLACEHOLDER"
HMS_100MS_WEBHOOK_SECRET="HMS_WEBHOOK_SECRET_PLACEHOLDER"

STORAGE_DRIVER="LOCAL_VPS"
LOCAL_UPLOAD_DIR="/var/www/argon-lms/uploads"
