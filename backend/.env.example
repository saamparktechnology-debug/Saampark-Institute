# Server & Environment (No surrounding quotes needed; env.ts also strips quotes automatically)
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata

# MySQL Database (Hostinger VPS / Local MySQL)
DATABASE_URL=mysql://lms_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:3306/argon_lms_db

# JWT & Session Security (Must be 32+ chars in production)
JWT_ACCESS_SECRET=CHANGE_ME_32_CHAR_MIN_ACCESS_SECRET_KEY_ARGON
JWT_REFRESH_SECRET=CHANGE_ME_32_CHAR_MIN_REFRESH_SECRET_KEY_ARGON
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SECURE=false

# Field-Level Encryption Key for UPI IDs (32-byte hex)
UPI_ENCRYPTION_KEY_HEX=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# ----------------------------------------------------------------------------
# Indian Tax Compliance (GST Tax Invoices SAC 999293 & Section 194J Teacher TDS)
# ----------------------------------------------------------------------------
INSTITUTE_STATE=West Bengal
INSTITUTE_GSTIN=19AABCS1429B1Z1
INSTITUTE_SAC_CODE=999293
DEFAULT_TEACHER_TDS_PERCENT=10

# ----------------------------------------------------------------------------
# Email Notifications (Hostinger SMTP / Gmail App Password / Resend API)
# ----------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_PROVIDER=HOSTINGER_SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alerts@saampark.edu.in
SMTP_PASS=CHANGE_ME_SMTP_OR_GMAIL_APP_PASSWORD
SMTP_FROM_NAME=Saampark Institute LMS
SMTP_FROM_EMAIL=alerts@saampark.edu.in
# Optional HTTP Email API alternative (https://resend.com)
RESEND_API_KEY=

# ----------------------------------------------------------------------------
# WhatsApp Notifications (Meta WhatsApp Cloud API / Twilio / WATI)
# Can also be turned ON/OFF live from Admin Panel -> Platform Settings
# ----------------------------------------------------------------------------
WHATSAPP_NOTIFICATIONS_ENABLED=true
WHATSAPP_PROVIDER=META_CLOUD_API
WHATSAPP_BUSINESS_NUMBER=+919830044556
WHATSAPP_API_VERSION=v20.0
# Meta Cloud API (https://developers.facebook.com/apps -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_META_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_META_PERMANENT_ACCESS_TOKEN

# Optional Twilio WhatsApp Alternative
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional WATI WhatsApp Gateway Alternative
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=

# ----------------------------------------------------------------------------
# Indian DLT Transactional SMS Fallback (MSG91 / Fast2SMS / Textlocal / Twilio)
# Kept FALSE by default while DLT registration is pending; can be toggled ON
# anytime from Admin Panel -> Platform Settings!
# ----------------------------------------------------------------------------
SMS_DLT_ENABLED=false
SMS_DLT_PROVIDER=MSG91_DLT
SMS_DLT_ENTITY_ID=1201159000000000000
SMS_DLT_SENDER_ID=SAAMPK
SMS_DLT_TEMPLATE_ID_DEFAULT=1207161000000000000
SMS_DLT_API_KEY=

# ----------------------------------------------------------------------------
# Razorpay Checkout, 100ms Live Video & Local/VPS Binary File Storage
# ----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=RAZORPAY_SECRET_PLACEHOLDER
RAZORPAY_WEBHOOK_SECRET=RAZORPAY_WEBHOOK_SECRET_PLACEHOLDER

HMS_100MS_ACCESS_KEY=HMS_ACCESS_KEY_PLACEHOLDER
HMS_100MS_APP_SECRET=HMS_APP_SECRET_PLACEHOLDER
HMS_100MS_WEBHOOK_SECRET=HMS_WEBHOOK_SECRET_PLACEHOLDER

STORAGE_DRIVER=LOCAL_VPS
LOCAL_UPLOAD_DIR=./uploads

# ----------------------------------------------------------------------------
# Jitsi Meet Live Classroom (Zero Credit Card, Localhost & Hostinger VPS Ready)
# Default meet.ffmuc.net has no 5-minute iframe limit; can also be set to
# meet.jit.si, 8x8.vc, or your self-hosted Hostinger VPS meet.yourdomain.com
# ----------------------------------------------------------------------------
JITSI_DOMAIN=meet.ffmuc.net
JITSI_APP_SECRET=saampark_jitsi_room_secret_key
